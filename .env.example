# Copiar a .env.local y completar con valores reales. Nunca commitear .env.local.

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Clerk (autenticación) ---------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Neon (PostgreSQL) -------------------------------------------------------
# Conexión pooled: la usa la app en runtime.
DATABASE_URL=postgresql://<usuario>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# Conexión directa: solo para migraciones.
DATABASE_URL_UNPOOLED=postgresql://<usuario>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require
# Rol de solo lectura para el módulo de insights.
DATABASE_URL_READONLY=postgresql://<usuario_ro>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require

# --- Cron (Netlify scheduled functions) --------------------------------------
# Secreto compartido que valida las llamadas a /api/cron/*.
CRON_SECRET=<string-aleatorio-largo>

# --- AWS S3: fotos de perfil de deportistas ---------------------------------
# Prefijo S3_ (no AWS_): Netlify reserva AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION.
#
# 1) Bucket PRIVADO (son fotos de menores): dejar activado "Block all public access".
#    La app muestra las fotos con URLs prefirmadas que vencen en 1 hora.
#
# 2) Usuario IAM dedicado, con una policy de mínimo privilegio limitada al prefijo deportistas/:
#    {
#      "Version": "2012-10-17",
#      "Statement": [
#        {
#          "Effect": "Allow",
#          "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
#          "Resource": "arn:aws:s3:::<bucket>/deportistas/*"
#        },
#        {
#          "Effect": "Allow",
#          "Action": "s3:ListBucket",
#          "Resource": "arn:aws:s3:::<bucket>"
#        }
#      ]
#    }
#    s3:ListBucket hace falta para verificar que una foto existe antes de guardarla:
#    sin ese permiso S3 responde 403 (en vez de 404) a un objeto inexistente y el
#    guardado falla con error 500. Va sobre el bucket (sin /*) y sin condición de
#    prefijo, porque HeadObject no manda prefijo y la condición no aplicaría.
#
# 3) CORS del bucket (Permissions > Cross-origin resource sharing), para que el browser
#    pueda subir directo con el PUT prefirmado:
#    [
#      {
#        "AllowedMethods": ["PUT", "GET"],
#        "AllowedOrigins": ["http://localhost:3000", "https://<tu-sitio>.netlify.app"],
#        "AllowedHeaders": ["Content-Type"],
#        "MaxAgeSeconds": 3000
#      }
#    ]
# 4) Lifecycle rules: NO configurar una regla de expiración sobre deportistas/.
#    S3 no sabe qué keys están guardadas en la DB, así que borraría también las
#    fotos en uso. Las subidas que no llegan a guardarse se descartan desde la app
#    (DELETE /api/deportistas/foto). Si algún día se quiere una red de seguridad
#    automática, habría que subir primero a un prefijo tmp/, mover el objeto a
#    deportistas/ al guardar y recién ahí expirar tmp/ (ej. a 1 día).
S3_REGION=us-east-1
S3_BUCKET=adn-mens-sana
S3_ACCESS_KEY_ID=AKIA...
S3_SECRET_ACCESS_KEY=...
