generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Disciplina {
  FUTBOL
  FUTSAL
  BASQUET
  VOLEY
  HANDBALL
  NATACION
  ATLETISMO
  HOCKEY
  RUGBY
  TENIS
  GIMNASIA
  GIMNASIA_ARTISTICA
  PATIN
  ARTES_MARCIALES
  COMBATE
  INICIACION_DEPORTIVA
  POWER_CHAIR
  TIADE
  AJEDREZ
  BOXEO
  OTRO
}

enum EstadoDeportista {
  ACTIVO
  INACTIVO
  LESIONADO
  SUSPENDIDO
}

enum Genero {
  MASCULINO
  FEMENINO
  NO_BINARIO
  PREFIERO_NO_DECIR
}

enum ActividadComplementaria {
  GIMNASIO
  TECNICA_INDIVIDUAL
  AMBAS
  NINGUNA
}

enum NivelEstudio {
  PRIMARIO_INCOMPLETO
  PRIMARIO_EN_CURSO
  PRIMARIO_COMPLETO
  SECUNDARIO_INCOMPLETO
  SECUNDARIO_EN_CURSO
  SECUNDARIO_COMPLETO
  TERCIARIO_INCOMPLETO
  TERCIARIO_EN_CURSO
  TERCIARIO_COMPLETO
}

enum SituacionLaboral {
  ALGUIEN_TRABAJA
  NADIE_TRABAJA
  SIN_DATO
}

enum MedioTransporte {
  TRANSPORTE_PUBLICO
  TRANSPORTE_FAMILIAR
  TRANSPORTE_DEL_CLUB
  OTRO
}

enum CondicionVivienda {
  PROPIA
  CEDIDA
  ALQUILADA
  OTRO
}

enum DificultadAlimentacion {
  NUNCA
  A_VECES
  FRECUENTEMENTE
}

enum TipoApoyo {
  ECONOMICO
  ALIMENTACION
  TRANSPORTE
  EDUCATIVO
  PSICOLOGICO
  NINGUNO
  OTRO
}

enum Servicio {
  LUZ
  GAS
  AGUA_CORRIENTE
  TELEFONO
  CABLE
  INTERNET
  SEGURIDAD
  ALARMA
  NINGUNA
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Deportista {
  id                      String                   @id @default(cuid())
  apellido                String
  nombre                  String
  dni                     String                   @unique
  fechaNacimiento         DateTime                 @map("fecha_nacimiento")
  provincia               String?
  ciudad                  String?
  genero                  Genero?
  telefono                String?
  email                   String?                  @unique
  domicilioActual         String?                  @map("domicilio_actual")
  nacionalidad            String?
  contactoEmergencia      String?                  @map("contacto_emergencia")
  vivePensionClub         Boolean                  @default(false) @map("vive_pension_club")
  vivePensionExterna      Boolean                  @default(false) @map("vive_pension_externa")
  observaciones           String?

  // Sport fields (scalar — single discipline per athlete)
  disciplina              Disciplina?
  categoriaId             String?                  @map("categoria_id")
  categoria               Categoria?               @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  posicion                String?
  estado                  EstadoDeportista         @default(ACTIVO)
  actividadComplementaria ActividadComplementaria? @map("actividad_complementaria")
  fechaIngreso            DateTime?                @map("fecha_ingreso")
  esRepresentante         Boolean                  @default(false) @map("es_representante")

  // 1:N relations
  clubesAnteriores        ClubAnterior[]
  historiaDeportiva       HistoriaDeportiva[]
  turnosDeportista        TurnoDeportista[]
  seguimientos            Seguimiento[]

  // 1:1 satellite models
  datosEscolares          DatosEscolares?
  datosSociales           DatosSociales?
  viviendaFamiliar        ViviendaFamiliar?
  datosFamiliares         DatosFamiliares?
  necesidadesApoyo        NecesidadesApoyo?
  datosSalud              DatosSalud?

  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")

  @@map("deportistas")
}

model ClubAnterior {
  id           String     @id @default(cuid())
  deportistaId String     @map("deportista_id")
  nombre       String
  periodo      String?

  deportista   Deportista @relation(fields: [deportistaId], references: [id], onDelete: Cascade)

  @@map("clubes_anteriores")
}

model HistoriaDeportiva {
  id           String     @id @default(cuid())
  deportistaId String     @map("deportista_id")
  descripcion  String
  fecha        DateTime   @default(now())

  deportista   Deportista @relation(fields: [deportistaId], references: [id], onDelete: Cascade)

  @@map("historia_deportiva")
}

model DatosEscolares {
  id                String        @id @default(cuid())
  deportistaId      String        @unique @map("deportista_id")
  nivelEstudio      NivelEstudio? @map("nivel_estudio")
  nombreColegio     String?       @map("nombre_colegio")
  anoCursa          Int?          @map("ano_cursa")
  materiasAdeudadas String?       @map("materias_adeudadas")

  deportista        Deportista    @relation(fields: [deportistaId], references: [id], onDelete: Cascade)

  @@map("datos_escolares")
}

model DatosSociales {
  id                       String            @id @default(cuid())
  deportistaId             String            @unique @map("deportista_id")
  trabaja                  Boolean?
  situacionLaboralHogar    SituacionLaboral? @map("situacion_laboral_hogar")
  conQuienVive             String?           @map("con_quien_vive")
  composicionGrupoFamiliar String?           @map("composicion_grupo_familiar")

  deportista               Deportista        @relation(fields: [deportistaId], references: [id], onDelete: Cascade)

  @@map("datos_sociales")
}

model DatosFamiliares {
  id                String     @id @default(cuid())
  deportistaId      String     @unique @map("deportista_id")

  padreNombre       String?    @map("padre_nombre")
  padreApellido     String?    @map("padre_apellido")
  padreNacionalidad String?    @map("padre_nacionalidad")
  padreOcupacion    String?    @map("padre_ocupacion")

  madreNombre       String?    @map("madre_nombre")
  madreApellido     String?    @map("madre_apellido")
  madreNacionalidad String?    @map("madre_nacionalidad")
  madreOcupacion    String?    @map("madre_ocupacion")

  deportista        Deportista @relation(fields: [deportistaId], references: [id], onDelete: Cascade)

  @@map("datos_familiares")
}

model ViviendaFamiliar {
  id                    String             @id @default(cuid())
  deportistaId          String             @unique @map("deportista_id")
  personasDependientes  Int?               @map("personas_dependientes")
  medioTransporte       MedioTransporte?   @map("medio_transporte")
  condicionVivienda     CondicionVivienda? @map("condicion_vivienda")
  cuentaConHabitaciones Boolean?           @map("cuenta_con_habitaciones")

  servicios             ServicioVivienda[]

  deportista            Deportista         @relation(fields: [deportistaId], references: [id], onDelete: Cascade)

  @@map("vivienda_familiar")
}

model ServicioVivienda {
  id                 String           @id @default(cuid())
  viviendaFamiliarId String           @map("vivienda_familiar_id")
  servicio           Servicio

  viviendaFamiliar   ViviendaFamiliar @relation(fields: [viviendaFamiliarId], references: [id], onDelete: Cascade)

  @@unique([viviendaFamiliarId, servicio])
  @@map("servicios_vivienda")
}

model NecesidadesApoyo {
  id                     String                  @id @default(cuid())
  deportistaId           String                  @unique @map("deportista_id")
  dificultadAlimentacion DificultadAlimentacion? @map("dificultad_alimentacion")
  recibeVianda           Boolean                 @default(false) @map("recibe_vianda")
  esSocio                Boolean                 @default(false) @map("es_socio")

  apoyosRequeridos       ApoyoRequerido[]

  deportista             Deportista              @relation(fields: [deportistaId], references: [id], onDelete: Cascade)

  @@map("necesidades_apoyo")
}

model ApoyoRequerido {
  id                 String           @id @default(cuid())
  necesidadesApoyoId String           @map("necesidades_apoyo_id")
  tipo               TipoApoyo

  necesidadesApoyo   NecesidadesApoyo @relation(fields: [necesidadesApoyoId], references: [id], onDelete: Cascade)

  @@unique([necesidadesApoyoId, tipo])
  @@map("apoyos_requeridos")
}

model DatosSalud {
  id                              String   @id @default(cuid())
  deportistaId                    String   @unique @map("deportista_id")
  grupoSanguineo                  String?  @map("grupo_sanguineo")
  horasSuenio                     String?  @map("horas_suenio")
  obraSocial                      String?  @map("obra_social")
  antecedenteMuerteSubitaFamiliar Boolean? @map("antecedente_muerte_subita_familiar")
  antecedentesQuirurgicos         String?  @map("antecedentes_quirurgicos")
  medicacionCronica               String?  @map("medicacion_cronica")
  historialLesiones               String?  @map("historial_lesiones")

  enfermedadesPreexistentes       EnfermedadPreexistenteItem[]
  antecedentesEnfermedadesFam     AntecedenteEnfermedadFamiliarItem[]

  deportista                      Deportista @relation(fields: [deportistaId], references: [id], onDelete: Cascade)

  @@map("datos_salud")
}

model EnfermedadPreexistenteItem {
  id           String                 @id @default(cuid())
  datosSaludId String                 @map("datos_salud_id")
  enfermedad   EnfermedadPreexistente

  datosSalud   DatosSalud @relation(fields: [datosSaludId], references: [id], onDelete: Cascade)

  @@unique([datosSaludId, enfermedad])
  @@map("enfermedades_preexistentes")
}

model AntecedenteEnfermedadFamiliarItem {
  id           String                        @id @default(cuid())
  datosSaludId String                        @map("datos_salud_id")
  antecedente  AntecedenteEnfermedadFamiliar

  datosSalud   DatosSalud @relation(fields: [datosSaludId], references: [id], onDelete: Cascade)

  @@unique([datosSaludId, antecedente])
  @@map("antecedentes_enfermedades_familiares")
}

// ---------------------------------------------------------------------------
// Enums — Salud
// ---------------------------------------------------------------------------

enum EnfermedadPreexistente {
  PRESION_ARTERIAL
  DIABETES
  ASMA
  CHAGAS
  EPILEPSIA
  MIGRANA
  COVID
  ALERGIAS
  ETS
  OTRO
}

model Turno {
  id            String            @id @default(cuid())
  titulo        String
  fecha         DateTime
  hora          String
  lugar         String
  descripcion   String?
  profesionalId String            @map("profesional_id")

  deportistas   TurnoDeportista[]

  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@map("turnos")
}

model TurnoDeportista {
  id           String     @id @default(cuid())
  turnoId      String     @map("turno_id")
  deportistaId String     @map("deportista_id")

  turno        Turno      @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  deportista   Deportista @relation(fields: [deportistaId], references: [id], onDelete: Cascade)

  @@unique([turnoId, deportistaId])
  @@map("turno_deportistas")
}

// ---------------------------------------------------------------------------
// Enums — Seguimientos
// ---------------------------------------------------------------------------

enum PrioridadSeguimiento {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum TipoSeguimiento {
  GENERICO
  TRAUMATOLOGIA
  HISTORIA_CLINICA
  EVALUACION_PSICOLOGICA
  EVALUACION_CARDIOLOGICA
}

// ---------------------------------------------------------------------------
// Models — Seguimientos
// ---------------------------------------------------------------------------

model Seguimiento {
  id                   String               @id @default(cuid())
  deportistaId         String               @map("deportista_id")
  profesionalId        String               @map("profesional_id")
  fecha                DateTime
  titulo               String
  descripcion          String?
  recomendaciones      String?
  resultadosEvaluacion String?              @map("resultados_evaluacion")
  prioridad            PrioridadSeguimiento @default(MEDIA)
  proximaCita          DateTime?            @map("proxima_cita")
  alertaSeguimiento    String?              @map("alerta_seguimiento")
  tipoSeguimiento      TipoSeguimiento?     @map("tipo_seguimiento")

  deportista               Deportista                       @relation(fields: [deportistaId], references: [id], onDelete: Cascade)
  traumatologia            SeguimientoTraumatologia?
  historiaClinica          SeguimientoHistoriaClinica?
  evaluacionPsicologica    SeguimientoEvaluacionPsicologica?
  evaluacionCardiologica   SeguimientoEvaluacionCardiologica?

  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  @@map("seguimientos")
}

model SeguimientoTraumatologia {
  id                    String      @id @default(cuid())
  seguimientoId         String      @unique @map("seguimiento_id")
  estabilidadHombro     String?     @map("estabilidad_hombro")
  estabilidadRodilla    String?     @map("estabilidad_rodilla")
  estabilidadTobillo    String?     @map("estabilidad_tobillo")
  movilidadHombro       String?     @map("movilidad_hombro")
  movilidadCadera       String?     @map("movilidad_cadera")
  movilidadRodilla      String?     @map("movilidad_rodilla")
  movilidadTobillo      String?     @map("movilidad_tobillo")
  discrepanciaAsimetria String?     @map("discrepancia_asimetria")
  postura               String?
  laxitud               String?
  podoscopia            String?
  observaciones         String?

  seguimiento           Seguimiento @relation(fields: [seguimientoId], references: [id], onDelete: Cascade)

  @@map("seguimientos_traumatologia")
}

model SeguimientoHistoriaClinica {
  id                   String      @id @default(cuid())
  seguimientoId        String      @unique @map("seguimiento_id")
  tensionArterial      String?     @map("tension_arterial")
  auscultacionPulmonar String?     @map("auscultacion_pulmonar")
  avOjoDerecho         String?     @map("av_ojo_derecho")
  avOjoIzquierdo       String?     @map("av_ojo_izquierdo")
  diagnostico          String?

  seguimiento          Seguimiento @relation(fields: [seguimientoId], references: [id], onDelete: Cascade)

  @@map("seguimientos_historia_clinica")
}

model SeguimientoEvaluacionPsicologica {
  id                       String      @id @default(cuid())
  seguimientoId            String      @unique @map("seguimiento_id")
  cprdControlEstres        Int?        @map("cprd_control_estres")
  cprdInfluenciaEvaluacion Int?        @map("cprd_influencia_evaluacion")
  cprdMotivacion           Int?        @map("cprd_motivacion")
  cprdHabilidadMental      Int?        @map("cprd_habilidad_mental")
  cprdCohesionEquipo       Int?        @map("cprd_cohesion_equipo")
  sociograma               String?
  poms                     String?
  staiRasgo                Int?        @map("stai_rasgo")
  staiEstado               Int?        @map("stai_estado")
  observaciones            String?

  seguimiento              Seguimiento @relation(fields: [seguimientoId], references: [id], onDelete: Cascade)

  @@map("seguimientos_evaluacion_psicologica")
}

model SeguimientoEvaluacionCardiologica {
  id                 String      @id @default(cuid())
  seguimientoId      String      @unique @map("seguimiento_id")
  ecg                String?
  examenFisico       String?     @map("examen_fisico")
  sintomas           String?
  estudiosAnteriores String?     @map("estudios_anteriores")
  diagnostico        String?
  observaciones      String?

  seguimiento        Seguimiento @relation(fields: [seguimientoId], references: [id], onDelete: Cascade)

  @@map("seguimientos_evaluacion_cardiologica")
}

enum AntecedenteEnfermedadFamiliar {
  DIABETES
  EPOC
  DISLIPEMIAS
  HIPOTIROIDISMO
  HIPERTIROIDISMO
  ASMA
  CANCER
  CHAGAS
  MIGRANA
  HIPERTENSION_ARTERIAL
  CORONARIOPATIAS
  OTRO
}

// ---------------------------------------------------------------------------
// Enums — Calendario
// ---------------------------------------------------------------------------

enum TipoDia {
  TORNEO
  RECESO
  RECUPERO
  SIN_ACTIVIDAD
}

enum EstadoEvento {
  PROGRAMADO
  SUSPENDIDO
  REPROGRAMADO
}

// ---------------------------------------------------------------------------
// Models — Calendario
// ---------------------------------------------------------------------------

model Equipo {
  id               String         @id @default(cuid())
  nombre           String         @unique
  esGimnasiaLP     Boolean        @default(false) @map("es_gimnasia_lp")
  eventosLocal     EventoTorneo[] @relation("EventoLocal")
  eventosVisitante EventoTorneo[] @relation("EventoVisitante")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@map("equipos")
}

model Categoria {
  id          String         @id @default(cuid())
  nombre      String         @unique
  orden       Int
  eventos     EventoTorneo[]
  deportistas Deportista[]

  @@map("categorias")
}

model DiaCalendario {
  id          String         @id @default(cuid())
  fecha       DateTime       @unique @db.Date
  tipo        TipoDia
  numeroFecha Int?           @map("numero_fecha")
  eventos     EventoTorneo[]
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@map("dias_calendario")
}

model EventoTorneo {
  id              String          @id @default(cuid())
  diaCalendarioId String          @map("dia_calendario_id")
  categoriaId     String          @map("categoria_id")
  localId         String          @map("local_id")
  visitanteId     String          @map("visitante_id")
  estado          EstadoEvento    @default(PROGRAMADO)
  dia             DiaCalendario   @relation(fields: [diaCalendarioId], references: [id], onDelete: Cascade)
  categoria       Categoria       @relation(fields: [categoriaId], references: [id])
  local           Equipo          @relation("EventoLocal", fields: [localId], references: [id])
  visitante       Equipo          @relation("EventoVisitante", fields: [visitanteId], references: [id])
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@unique([diaCalendarioId, categoriaId])
  @@map("eventos_torneo")
}
