      {
        "titulo": "Entregas fuera de la ficha: almuerzo o cena no previstos",
        "descripcion": "Almuerzos y cenas entregados a deportistas cuya ficha no los prevé. Sirve para detectar fichas desactualizadas y para revisar entregas fuera de lo planificado.",
        "tipo": "table",
        "querySpec": {
          "mode": "builder",
          "dataset": "viandas_entregas",
          "dimensions": [
            "deportista",
            "comida",
            "lugar",
            "fecha"
          ],
          "measures": [
            "entregas"
          ],
          "filters": {
            "op": "any",
            "children": [
