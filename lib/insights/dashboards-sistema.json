                    "field": "comida",
                    "operator": "eq",
                    "value": "ALMUERZO"
                  },
                  {
                    "field": "recibe_almuerzo",
                    "operator": "is_false"
                  }
                ]
              },
              {
                "op": "all",
                "children": [
                  {
                    "field": "comida",
                    "operator": "eq",
                    "value": "CENA"
                  },
                  {
                    "field": "recibe_cena",
                    "operator": "is_false"
                  }
                ]
              }
            ]
          },
          "sort": [
